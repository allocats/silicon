config {
	compiler: clang
	build_dir: build/
	default_flags: -Wall -Wextra
}

target executable silicon {
	sources: src/main.c
	flags: -O3
	output: build/bin/silicon
}

target debug silicon_debug {
	sources: src/main.c
	flags: -O0 -g3 -fsanitize=address -Weverything
	output: build/debug/silicon_debug
}

target test silicon_tests {
	sources: tests/test_main.c
	flags: -g -Weverything
	output: build/tests/silicon_test
}